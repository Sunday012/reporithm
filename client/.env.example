# Optional: raises GitHub's API rate limit for repository analysis.
GITHUB_TOKEN=

# Required for verified code-quality results.
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=
SONARQUBE_AUTO_SCAN=false

# Optional. Supported placeholders: {owner}, {repo}, {fullName}
# The default lookup also tries owner_repo, owner:repo, owner/repo, and repo.
SONARQUBE_PROJECT_KEY_TEMPLATE={owner}_{repo}
