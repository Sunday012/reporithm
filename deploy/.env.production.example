# Public DNS names pointed at the VPS before starting Caddy.
SONAR_HOSTNAME=sonar.example.com
SCANNER_HOSTNAME=scanner.example.com
ACME_EMAIL=you@example.com

# Generate the first two with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-value
SCAN_WORKER_SECRET=replace-with-a-different-random-value

# Generate with: openssl rand -base64 32
SONAR_AUTH_JWTBASE64HS256SECRET=replace-with-a-base64-random-value

# Create this user token in SonarQube after the first server startup.
SONARQUBE_TOKEN=replace-after-sonarqube-setup

# Pinned for repeatable deployments. Upgrade deliberately after backing up.
SONARQUBE_IMAGE=sonarqube:26.9.0.129388-community

MAX_CONCURRENT_SCANS=1
MAX_QUEUED_SCANS=10
MAX_CHECKOUT_MB=500
SCAN_TIMEOUT_MS=210000
MAX_FREE_ANALYSES=1
